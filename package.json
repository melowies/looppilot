{
  "name": "looppilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:crud": "playwright test --config playwright.crud.config.ts",
    "browser:install": "playwright install chromium",
    "format": "prettier --write src tests e2e e2e-crud scripts vitest.config.ts playwright.config.ts playwright.crud.config.ts postcss.config.mjs eslint.config.mjs package.json tsconfig.json",
    "postinstall": "node scripts/prepare-monaco.mjs && node scripts/prepare-python.mjs",
    "predev": "node scripts/prepare-monaco.mjs && node scripts/prepare-python.mjs",
    "prebuild": "node scripts/prepare-monaco.mjs && node scripts/prepare-python.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.76.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "next": "^16.0.0",
    "pyodide": "0.27.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
