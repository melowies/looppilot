# Public Supabase project configuration (never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only. Coaching also requires consent in availability settings.
# Leave empty for deterministic scheduling without external AI.
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Opt in only on your own local Node server. No OpenAI API key is needed for ChatGPT.
LOOPPILOT_CHATGPT_LOCAL=0
LOOPPILOT_LOCAL_ORIGIN=http://127.0.0.1:3000
